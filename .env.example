# Netlify Functions 환경 변수 (Netlify 대시보드 → Site settings → Environment variables)
# 이 파일은 예시이며 실제 값은 절대 저장소에 커밋하지 마세요.

# Claude API 키 (Anthropic Console에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# 관리자 강제 재생성 비밀번호 (충분히 길게, 12자 이상 권장)
ADMIN_PASSWORD=

# (선택) 추가로 허용할 CORS 오리진. 쉼표로 구분.
# 기본 허용: https://bleponation.netlify.app, https://<이름>--bleponation.netlify.app, http://localhost:8888, http://localhost:5173
ALLOWED_ORIGINS=
